# Copiez ce fichier en .env puis adaptez-le.
PORT=3000

# OBLIGATOIRE en production : longue chaîne aléatoire (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Origines autorisées (séparées par des virgules). Inutile en dev avec le proxy Vite.
CORS_ORIGINS=http://localhost:5173

# Base SQLite et dossier des images envoyées
DB_PATH=data/selline.db
UPLOAD_DIR=uploads

# Laisser vide pour des URL d'images relatives (/api/uploads/...).
# En production avec un domaine d'API séparé : https://api.mon-domaine.cm
PUBLIC_URL=

# Administrateur (production) : crée ou promeut ce compte au démarrage.
# Mot de passe nécessaire seulement si le compte n'existe pas encore (8 caractères minimum). Retirez-le ensuite.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Insère des données de démonstration au premier lancement (ignoré si NODE_ENV=production)
SEED_DEMO=true
