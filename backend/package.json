{
  "name": "selline-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de Selline (Node.js, Express, SQLite)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed-cli.js",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('Base supprimée')\"",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "admin": "node --disable-warning=ExperimentalWarning src/admin-cli.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  }
}
